# Ollama model used by the planner and repair steps.
DEMOFORGE_MODEL=qwen2.5:7b-instruct
# Base URL of the local Ollama server.
DEMOFORGE_OLLAMA_URL=http://localhost:11434
# Set to 1 to use fixture-backed mocks instead of the real modules.
USE_MOCKS=0
# Set to 1 to run the browser headless (0 shows the window while recording).
DEMOFORGE_HEADLESS=0
# Delay in milliseconds between browser actions so the video is watchable.
DEMOFORGE_SLOWMO=450
# Seconds a person would need to build the same demo by hand, used for the metrics comparison.
DEMOFORGE_MANUAL_BASELINE_SEC=9000
# Path to a saved plan JSON to reuse instead of calling the model (empty = off).
# Relative paths start at the repo root, e.g. docs/fallback/cached-plan.json. Read before every job: no restart needed.
DEMOFORGE_CACHED_PLAN=
